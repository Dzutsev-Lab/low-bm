# Copy this file to workflow/envs/micRoclean-source.env on the HPC, then fill
# in the private or public Git source for the patched micRoclean package.
# The real micRoclean-source.env file is ignored by git.

MICROCLEAN_GIT_URL=git@github.com:your-org/micRoclean.git
MICROCLEAN_GIT_REF=0123456789abcdef0123456789abcdef01234567

# Optional: set this if the R package is in a subdirectory of the Git repo.
# MICROCLEAN_GIT_SUBDIR=path/to/package

SCRUB_GIT_URL=https://github.com/Shenhav-and-Korem-labs/SCRuB.git
SCRUB_GIT_REF=0123456789abcdef0123456789abcdef01234567

# Upstream ANCOMBC version with quadprog in place of CVXR for constrained optimization.
ANCOMBC_GIT_URL=https://github.com/FrederickHuangLin/ANCOMBC.git
ANCOMBC_GIT_REF=0123456789abcdef0123456789abcdef01234567
